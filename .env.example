# MAPA Property — variables d'environnement
# Copier ce fichier en .env.local et remplir avec les vraies valeurs.
# .env.local est ignoré par git (cf. .gitignore).

# ===== Supabase (anon key publique, sans risque) =====
NEXT_PUBLIC_SUPABASE_URL=https://dutfkblygfvhhwpzxmfz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — bypass RLS (crons / scripts server-side).
# Source : Supabase Dashboard > Project Settings > API > service_role key.
# NE JAMAIS exposer cote client (server-only). Sans cette cle, les routes
# qui ecrivent en bypass RLS basculent en mode no-op (cf. /api/cron/bce-rates).
SUPABASE_SERVICE_ROLE_KEY=

# ===== Email — SMTP IONOS (lib/email/smtp.ts) =====
# Connexion TLS implicite, port 465. Utilise par tous les flux publics
# (lib/email/lead-emails.ts, lib/email/estimation-emails.ts). Si l'une
# des 4 variables manque, l'envoi est ignore (log, jamais de throw).
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_USER=site@mapagroup.org
SMTP_PASSWORD=
# Limite d'envoi horaire best effort (memoire, par instance serverless).
# Optionnelle : 50 par defaut la premiere semaine IONOS, a relever a 500
# ensuite en definissant cette variable dans Vercel.
EMAIL_RATE_LIMIT_PER_HOUR=50

# RESEND_API_KEY et MAPA_NOTIFICATION_EMAIL : non utilisees. Resend a ete
# retire au profit du SMTP IONOS ci-dessus ; le destinataire interne est
# desormais fixe (j.brebion@mapagroup.org, cf. lib/email/smtp.ts).
RESEND_API_KEY=
MAPA_NOTIFICATION_EMAIL=j.brebion@mapagroup.org

# ===== Cloudflare Turnstile =====
# Créer un site sur dash.cloudflare.com → Turnstile → Add site (mapaproperty.lu).
# Le composant <Turnstile /> est désactivé (no-op) si NEXT_PUBLIC_TURNSTILE_SITE_KEY
# est absent. La vérification serveur dans /api/lead est alors permissive.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== Mistral AI (chatbot Eléna principal) =====
# console.mistral.ai → API keys. Si absent, Eléna utilise un fallback heuristique.
MISTRAL_API_KEY=

# ===== Groq (fallback Eléna) =====
# console.groq.com → API keys. Si absent, Eléna ne fait pas de fallback.
GROQ_API_KEY=

# ===== Google Analytics 4 — tag visiteur (gtag.js) =====
# Measurement ID (format G-XXXXXXX), trouvable dans GA4 → Admin → Flux de
# données → [ton flux Web], en haut à droite de la fiche du flux.
# Chargé UNIQUEMENT après consentement "Statistiques" de la bannière
# cookies (ConsentGatedAnalytics.tsx) — jamais avant. Si absent, le tag
# ne se charge pas, pas d'erreur. Volet séparé : l'accès API admin
# (GA4_PROPERTY_ID / GA4_SERVICE_ACCOUNT_KEY, /admin/analytics) n'est pas
# concerné par cette variable.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://mapaproperty.lu

# ===== Contact reveal (anti-bot) =====
# Coordonnées révélées par /api/contact-reveal après vérification UA + rate limit.
# Si absentes, fallback hardcodé dans route.ts (graceful degradation). L'objectif
# en prod est de retirer ces valeurs du code public — définir dans Vercel env vars.
MAPA_PHONE=+352 691 620 127
MAPA_EMAIL=j.brebion@mapagroup.org

# ===== ISR revalidation (Sprint OPTIM-1B C3) =====
# Token partage utilise par les scripts CLI (ex. pnpm purge:offmarket) pour
# appeler /api/admin/revalidate sans cookies admin SSR. Si absent cote
# serveur, seule l'auth admin SSR (bouton "Forcer le refresh" dans le BO)
# fonctionne. Generer une valeur aleatoire (ex. openssl rand -hex 32) et
# l'enregistrer aussi dans Vercel Project Settings > Environment Variables.
REVALIDATE_SECRET=

# ===== Cron Vercel =====
# Token d'authentification des crons. Vercel envoie automatiquement
# le header `Authorization: Bearer ${CRON_SECRET}` sur les routes
# declarees dans vercel.json. Sans cette cle, les routes cron renvoient
# 401 a tout appel (y compris Vercel) : a remplir en prod.
CRON_SECRET=

# ===== Apimo (integration annonces — en veille) =====
# Tant que ces 3 cles ne sont pas presentes, l'integration Apimo est en
# mode no-op total (aucun appel reseau, aucune ecriture properties).
# Source : compte Apimo > Provider > Credentials (provider_id + token) +
# Agency ID (ex. 3508). Activer en remplissant ces 3 vars dans Vercel env.
APIMO_PROVIDER_ID=
APIMO_TOKEN=
APIMO_AGENCY_ID=
APIMO_API_BASE=https://api.apimo.pro
