# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# claude code local settings
.claude/settings.local.json

# vercel
.vercel

# supabase CLI — contient des credentials de connexion en clair
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# qa visual-gate screenshots (binaires lourds — rapports .md conservés)
/docs/qa/screenshots-*/
backups-db/
scripts/output/

# Scripts ad hoc racine (service_role, non versionnés)
/._*.mjs
/._*.json
/._*.md
# Rapport d'audit interne (carte des vulnérabilités, ne jamais versionner)
/AUDIT_CONFORMITE.md

# Sources brutes volumineuses (cf. docs/REGISTRE_LOCALITES.md)
data/sources/
data/caclr/

# Rapports de tests QA / SEO (generes)
qa-reports/

# Fichiers internes jamais suivis (oct. 2026) : matrice de securite,
# sauvegardes, essais, rapports, donnees brutes, scripts ad hoc.
/docs/security/matrice.csv
/AUDIT_CONFORMITE.md
/backups-db/
/essais-pdf/
/qa-reports/
/data/sources/
/._*
/docs/security/inventaire.json
/docs/security/matrice-resume.md
/docs/security/rapport-audit.md
